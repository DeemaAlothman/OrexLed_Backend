# Template for the .env file created directly on the server (nano .env) — never committed.
# Used by docker-compose.prod.yml for both the "postgres" and "api" services.

# --- postgres service (internal only, no host port exposed) ---
POSTGRES_USER=orexled
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=orexled

# --- api service ---
# Host must be "postgres" (the compose service name), not localhost — they talk
# over the internal docker network, not the host network.
DATABASE_URL="postgresql://orexled:REPLACE_WITH_A_STRONG_PASSWORD@postgres:5432/orexled?schema=public"

NODE_ENV=production
PORT=3020

# comma separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend-domain.com

# generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
