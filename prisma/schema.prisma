// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum VideoStyle {
  REALISTIC
  CINEMATIC
  ANIMATED
  MINIMAL
}

enum VideoAspectRatio {
  LANDSCAPE
  PORTRAIT
}

enum VideoGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoCreditTransactionType {
  INITIAL_GRANT
  ADMIN_TOPUP
  GENERATION_SPEND
  GENERATION_REFUND
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum MaintenanceRequestStatus {
  NEW
  SCHEDULED
  DONE
  CANCELLED
}

enum RepresentativeStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  videoCredits Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens           RefreshToken[]
  videoGenerations        VideoGeneration[]
  videoCreditTransactions VideoCreditTransaction[] @relation("VideoCreditOwner")
  performedCreditTopUps   VideoCreditTransaction[] @relation("VideoCreditActor")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// طلب عرض سعر - يمكن لأي زائر تقديمه دون الحاجة لحساب
model QuoteRequest {
  id          String             @id @default(uuid())
  name        String
  phone       String
  location    String
  length      Float
  width       Float
  imagePath   String
  status      QuoteRequestStatus @default(NEW)
  note        String?
  quotedPrice Float?
  createdAt   DateTime           @default(now())

  representativeId String?
  representative    Representative? @relation(fields: [representativeId], references: [id])
  commission        Commission?

  @@index([representativeId])
  @@index([status])
  @@map("quote_requests")
}

/// كن مندوبنا - يمكن لأي شخص التقدم بهذا الطلب ليصبح مندوباً
model Representative {
  id             String                @id @default(uuid())
  name           String
  lineage        String
  fatherName     String
  motherName     String
  birthPlace     String
  birthDate      DateTime
  nationalId     String                @unique
  gender         Gender
  address        String
  phone          String
  shamCashWallet String?
  status         RepresentativeStatus  @default(APPROVED)
  createdAt      DateTime              @default(now())

  quoteRequests QuoteRequest[]
  commissions   Commission[]

  @@index([status])
  @@map("representatives")
}

/// مشاريعنا - يديفها الأدمن فقط، ويشوفها أي زائر
model Project {
  id          String   @id @default(uuid())
  imagePath   String
  videoPath   String
  description String
  createdAt   DateTime @default(now())

  @@map("projects")
}

/// طلب صيانة - يمكن لأي زائر تقديمه دون الحاجة لحساب
model MaintenanceRequest {
  id         String                    @id @default(uuid())
  name       String
  phone      String
  address    String
  imagePath  String
  problem    String
  status     MaintenanceRequestStatus  @default(NEW)
  note       String?
  assignedTo String?
  createdAt  DateTime                  @default(now())

  @@index([status])
  @@map("maintenance_requests")
}

/// عمولة مندوب عن طلب عرض سعر تحوّل لصفقة رابحة (WON)
model Commission {
  id               String    @id @default(uuid())
  quoteRequestId   String    @unique
  quoteRequest     QuoteRequest    @relation(fields: [quoteRequestId], references: [id])
  representativeId String
  representative   Representative  @relation(fields: [representativeId], references: [id])
  dealValue        Float?
  amount           Float?
  paid             Boolean   @default(false)
  paidAt           DateTime?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([representativeId])
  @@index([paid])
  @@map("commissions")
}

/// توليد فيديو بالذكاء الاصطناعي (Veo) لشاشات إعلامية - يتطلب حساب
model VideoGeneration {
  id           String                @id @default(uuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  prompt       String
  style        VideoStyle?
  aspectRatio  VideoAspectRatio      @default(LANDSCAPE)
  imagePath    String?
  status       VideoGenerationStatus @default(PENDING)
  videoPath    String?
  errorMessage String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  creditTransactions VideoCreditTransaction[]

  @@index([userId])
  @@map("video_generations")
}

/// سجل حركات رصيد الفيديو (منح أولي، شحن أدمن، استهلاك، استرجاع) - للتدقيق الكامل
model VideoCreditTransaction {
  id     String                     @id @default(uuid())
  userId String
  user   User                       @relation("VideoCreditOwner", fields: [userId], references: [id], onDelete: Cascade)
  type   VideoCreditTransactionType
  /// موجب للمنح/الشحن/الاسترجاع، سالب للاستهلاك
  amount       Int
  balanceAfter Int

  videoGenerationId String?
  videoGeneration   VideoGeneration? @relation(fields: [videoGenerationId], references: [id], onDelete: SetNull)

  performedByUserId String?
  performedBy       User?    @relation("VideoCreditActor", fields: [performedByUserId], references: [id], onDelete: SetNull)
  note              String?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@map("video_credit_transactions")
}
